{%- comment -%}
  snippets/meta-tags.liquid — SEO- & Social-Meta-Tags.
  page_description wird pro Seite/Produkt im Shopify-Admin gepflegt ("Suchmaschinen-Listing").
{%- endcomment -%}
{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_description = page_description | default: shop.description | default: shop.name
-%}
<meta name="description" content="{{ og_description | strip_html | truncate: 320 | escape }}">
<link rel="canonical" href="{{ canonical_url }}">
<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="website">
<meta property="og:description" content="{{ og_description | strip_html | truncate: 320 | escape }}">
{%- if page_image -%}
  <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="{{ page_image.width }}">
  <meta property="og:image:height" content="{{ page_image.height }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | strip_html | truncate: 200 | escape }}">
