{%- comment -%}
  snippets/product-card.liquid — Produktkarte für Collection/Suche.
  Parameter: product (product-Objekt)
{%- endcomment -%}
<a class="product-card" href="{{ product.url }}">
  {% render 'responsive-image',
    image: product.featured_image,
    alt: product.title,
    sizes: '(min-width: 990px) 300px, 45vw',
    aspect: '1',
    placeholder: 'product-apparel-1'
  %}
  <h3 class="product-card__title">{{ product.title | escape }}</h3>
  <p class="product-card__price">
    {%- if product.price_varies %}ab {% endif -%}
    {{ product.price_min | money }}
  </p>
</a>
