{%- comment -%}
  layout/password.liquid — Schlankes Layout für die Passwort-Seite
  (wird angezeigt, solange der Shop passwortgeschützt ist).
{%- endcomment -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_bg }}">
    <title>{{ shop.name }}</title>
    {%- render 'meta-tags' -%}
    {%- if settings.use_brand_fonts -%}
      <link rel="preconnect" href="https://fonts.googleapis.com">
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
      <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
    {%- else -%}
      <style>
        {{ settings.font_heading | font_face: font_display: 'swap' }}
        {{ settings.font_body | font_face: font_display: 'swap' }}
      </style>
    {%- endif -%}
    {%- render 'css-variables' -%}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="template-password">
    <main id="MainContent" role="main">
      {{ content_for_layout }}
    </main>
  </body>
</html>
