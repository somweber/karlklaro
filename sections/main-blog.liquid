{%- comment -%}
  sections/main-blog.liquid — Blog-Übersicht (z. B. Pflege-Tipps).
{%- endcomment -%}

<section class="section" style="--pt: 48px; --pb: 96px;">
  <div class="page-width">
    <header class="section-head">
      <h1>{{ blog.title }}</h1>
    </header>

    {%- paginate blog.articles by 9 -%}
      <div class="grid" style="--cols: 3; --cols-md: 2;">
        {%- for article in blog.articles -%}
          <a class="article-card" href="{{ article.url }}">
            {% render 'responsive-image',
              image: article.image,
              alt: article.title,
              sizes: '(min-width: 990px) 400px, 100vw',
              placeholder: 'lifestyle-1'
            %}
            <p class="article-card__date">{{ article.published_at | date: '%d.%m.%Y' }}</p>
            <h2 class="product-card__title">{{ article.title | escape }}</h2>
            <p class="text-muted" style="font-size: 0.95rem;">{{ article.excerpt_or_content | strip_html | truncate: 130 }}</p>
            <span class="service-card__link">{{ 'blog.read_more' | t }}{% render 'icon', name: 'arrow-right', size: 18 %}</span>
          </a>
        {%- endfor -%}
      </div>

      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Blog",
  "settings": []
}
{% endschema %}
