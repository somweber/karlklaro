{%- comment -%}
  sections/pricing-table.liquid — Preis-Pakete als Karten (Seite „Preise“).

  Einzige Datenquelle: die Paket-Kollektion (Standard „detailing-bundles“).
  Pakete sind echte Shopify-Produkte; Preis/Titel/Bild kommen aus dem Admin,
  die enthaltenen Leistungen aus dem Metafeld custom.bundle_includes
  (list.product_reference → Live-Referenzen auf die Leistungs-Produkte),
  der Ersparnis-Badge aus custom.savings_label. Keine manuellen Block-
  Fallbacks mehr. Ohne Pakete erscheint ein Leerzustand.

  Hinweis zur nativen „Shopify Bundles“-App: deren Komponenten sind in Liquid
  NICHT abrufbar (nur via Storefront API / App-Block) und passen nicht zum
  server-gerenderten Buchungs-Flow — siehe MIGRATION.md. Falls ein Produkt
  ohne bundle_includes in der Kollektion liegt, wird es ohne Inhaltsliste
  dargestellt (kein Bruch).
{%- endcomment -%}

{%- liquid
  assign bundles_collection = section.settings.bundles_collection
  if bundles_collection == blank
    assign bundles_collection = collections['detailing-bundles']
  endif
  assign booking_target = settings.booking_url | default: '/pages/buchung'
-%}

<section class="section section--{{ section.settings.background }}"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">

    {%- if section.settings.heading != blank -%}
      <header class="section-head section-head--center" data-reveal>
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="section-head__lead">{{ section.settings.text }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- if bundles_collection != blank and bundles_collection.products_count > 0 -%}
      <div class="pricing-grid">
        {%- for product in bundles_collection.products -%}
          {%- liquid
            assign includes = product.metafields.custom.bundle_includes.value
            assign savings = product.metafields.custom.savings_label.value
            assign duration_minutes = product.metafields.custom.duration_minutes.value
            assign card_text = product.metafields.custom.short_description.value | default: product.description | strip_html | truncate: 160
          -%}
          <div class="tier" data-reveal style="--reveal-delay: {{ forloop.index0 | times: 0.08 }}s">
            {%- if savings != blank -%}
              <span class="tier__badge">{{ savings | escape }}</span>
            {%- endif -%}

            <div>
              <h3>{{ product.title | escape }}</h3>
              {%- if card_text != blank -%}
                <p class="tier__tagline">{{ card_text }}</p>
              {%- endif -%}
            </div>

            <p class="tier__price">
              {{ product.price | money }}
              <small>
                inkl. USt.
                {%- if duration_minutes != blank %} · {% render 'duration', minutes: duration_minutes %}{% endif -%}
              </small>
            </p>

            {%- comment -%} Enthaltene Leistungen — Live-Referenzen, verschwinden automatisch, wenn ein Leistungs-Produkt gelöscht/deaktiviert wird {%- endcomment -%}
            {%- if includes -%}
              <ul class="tier__features">
                {%- for inc in includes -%}
                  {%- if inc != blank -%}
                    <li>{% render 'icon', name: 'check', size: 18 %}<span>{{ inc.title | escape }}</span></li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}

            {%- assign tier_target = booking_target | append: '?services=' | append: product.handle -%}
            {% render 'button', label: section.settings.product_cta_label, url: tier_target, style: 'primary' %}
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="empty-state">{{ 'general.bundles_empty' | t }}</p>
    {%- endif -%}

    {%- if section.settings.custom_label != blank and section.settings.custom_url != blank -%}
      <div class="pricing-custom" data-reveal>
        {% render 'button', label: section.settings.custom_label, url: section.settings.custom_url, style: 'ghost', icon: 'arrow-right' %}
      </div>
    {%- endif -%}

    {%- if section.settings.note != blank -%}
      <p class="pricing-note">{{ section.settings.note }}</p>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Preis-Pakete",
  "settings": [
    {
      "type": "header",
      "content": "Paket-Quelle"
    },
    {
      "type": "paragraph",
      "content": "Pakete werden als Produkte aus der Kollektion gezogen (Preis aus dem Admin, Inhalte aus dem Metafeld custom.bundle_includes). Leer lassen = automatisch „detailing-bundles“. Ohne aktive Pakete erscheint ein Leerzustand."
    },
    {
      "type": "collection",
      "id": "bundles_collection",
      "label": "Paket-Kollektion"
    },
    {
      "type": "text",
      "id": "product_cta_label",
      "label": "Paket-Button: Text",
      "default": "Jetzt buchen"
    },
    {
      "type": "header",
      "content": "Inhalt"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Overline",
      "default": "Pakete"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Pakete mit Vorteil."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Einleitung",
      "default": "Wähle das Paket, das zu deinem Fahrzeug passt – oder hol dir ein individuelles Angebot."
    },
    {
      "type": "text",
      "id": "custom_label",
      "label": "Individuelles Angebot: Button-Text",
      "default": "Individuelles Angebot anfragen"
    },
    {
      "type": "url",
      "id": "custom_url",
      "label": "Individuelles Angebot: Ziel"
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Hinweistext",
      "default": "Alle Preise inkl. 20 % USt. Richtpreise für PKW der Kompaktklasse – SUV, Van und stark verschmutzte Fahrzeuge gegen Aufpreis."
    },
    {
      "type": "select",
      "id": "background",
      "label": "Hintergrund",
      "options": [
        { "value": "base", "label": "Standard (dunkel)" },
        { "value": "surface", "label": "Anthrazit" },
        { "value": "navy", "label": "Navy" }
      ],
      "default": "base"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Abstand oben",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Abstand unten",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 96
    }
  ],
  "presets": [
    {
      "name": "Preis-Pakete",
      "category": "KlaroClean"
    }
  ]
}
{% endschema %}
