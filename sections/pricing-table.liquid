{%- comment -%}
  sections/pricing-table.liquid — Preis-Pakete als Karten.

  Paket-Quelle (Refactor „echte Bundle-Produkte“):
  1. Kollektion (Picker, sonst automatisch „detailing-bundles“): Pakete sind
     echte Shopify-Produkte — Preis/Titel/Verfügbarkeit kommen aus dem Admin,
     enthaltene Leistungen aus dem Metafeld custom.bundle_includes
     (list.product_reference), Ersparnis-Badge aus custom.savings_label.
     Der CTA führt zur Buchungsseite und wählt das Paket vor.
  2. Fallback: manuelle Blöcke (Textpreise „ab € 89“) wie bisher.
{%- endcomment -%}

{%- liquid
  assign bundles_collection = section.settings.bundles_collection
  if bundles_collection == blank
    assign bundles_collection = collections['detailing-bundles']
  endif
  assign use_bundle_products = false
  if bundles_collection != blank and bundles_collection.products_count > 0
    assign use_bundle_products = true
  endif
-%}

<section class="section section--{{ section.settings.background }}"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">

    {%- if section.settings.heading != blank -%}
      <header class="section-head section-head--center" data-reveal>
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="section-head__lead">{{ section.settings.text }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- if use_bundle_products -%}
      <div class="pricing-grid">
        {%- for product in bundles_collection.products -%}
          {%- liquid
            assign includes = product.metafields.custom.bundle_includes.value
            assign savings = product.metafields.custom.savings_label.value
            assign duration_minutes = product.metafields.custom.duration_minutes.value
            assign card_text = product.metafields.custom.short_description.value | default: product.description | strip_html | truncate: 160
            assign booking_target = settings.booking_url | default: '/pages/buchung'
          -%}
          <div class="tier" data-reveal style="--reveal-delay: {{ forloop.index0 | times: 0.08 }}s">
            {%- if savings != blank -%}
              <span class="tier__badge">{{ savings | escape }}</span>
            {%- endif -%}

            <div>
              <h3>{{ product.title | escape }}</h3>
              {%- if card_text != blank -%}
                <p class="tier__tagline">{{ card_text }}</p>
              {%- endif -%}
            </div>

            <p class="tier__price">
              {{ product.price | money }}
              <small>
                inkl. USt.
                {%- if duration_minutes != blank %} · {% render 'duration', minutes: duration_minutes %}{% endif -%}
              </small>
            </p>

            {%- if includes -%}
              <ul class="tier__features">
                {%- for inc in includes -%}
                  <li>{% render 'icon', name: 'check', size: 18 %}<span>{{ inc.title | escape }}</span></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}

            {%- assign tier_label = section.settings.product_cta_label -%}
            {%- assign tier_target = booking_target | append: '?services=' | append: product.handle -%}
            {% render 'button', label: tier_label, url: tier_target, style: 'primary' %}
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
    <div class="pricing-grid">
      {%- for block in section.blocks -%}
        <div class="tier{% if block.settings.featured %} tier--featured{% endif %}" data-reveal
          style="--reveal-delay: {{ forloop.index0 | times: 0.08 }}s" {{ block.shopify_attributes }}>

          {%- if block.settings.featured and block.settings.badge != blank -%}
            <span class="tier__badge">{{ block.settings.badge | escape }}</span>
          {%- endif -%}

          <div>
            <h3>{{ block.settings.title | escape }}</h3>
            {%- if block.settings.tagline != blank -%}
              <p class="tier__tagline">{{ block.settings.tagline | escape }}</p>
            {%- endif -%}
          </div>

          <p class="tier__price">
            {{ block.settings.price | escape }}
            {%- if block.settings.price_note != blank -%}
              <small>{{ block.settings.price_note | escape }}</small>
            {%- endif -%}
          </p>

          {%- if block.settings.features != blank -%}
            {%- assign features = block.settings.features | newline_to_br | split: '<br />' -%}
            <ul class="tier__features">
              {%- for feature in features -%}
                {%- assign f = feature | strip -%}
                {%- if f != blank -%}
                  <li>{% render 'icon', name: 'check', size: 18 %}<span>{{ f }}</span></li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}

          {%- liquid
            # Buchungs-Link: optional mit ?services=<handles> — die Buchungsseite
            # wählt diese Leistungen vor. Pakete sind reine Theme-Konfiguration,
            # KEINE eigenen Shopify-Produkte (eine Quelle der Wahrheit: die
            # Kollektion detailing-services).
            assign tier_cta_url = block.settings.cta_url | default: settings.booking_url | default: '/pages/buchung'
            if block.settings.included_services != blank
              assign tier_services = block.settings.included_services | replace: ' ', ''
              assign tier_cta_url = tier_cta_url | append: '?services=' | append: tier_services
            endif
            assign tier_style = 'outline'
            if block.settings.featured
              assign tier_style = 'primary'
            endif
          -%}
          {% render 'button', label: block.settings.cta_label, url: tier_cta_url, style: tier_style %}
        </div>
      {%- endfor -%}
    </div>
    {%- endif -%}

    {%- if section.settings.custom_label != blank and section.settings.custom_url != blank -%}
      <div class="pricing-custom" data-reveal>
        {% render 'button', label: section.settings.custom_label, url: section.settings.custom_url, style: 'ghost', icon: 'arrow-right' %}
      </div>
    {%- endif -%}

    {%- if section.settings.note != blank -%}
      <p class="pricing-note">{{ section.settings.note }}</p>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Preis-Pakete",
  "settings": [
    {
      "type": "header",
      "content": "Paket-Quelle"
    },
    {
      "type": "paragraph",
      "content": "Mit Kollektion werden Pakete als echte Produkte gerendert (Preis aus dem Admin, Inhalte aus custom.bundle_includes). Leer = automatisch „detailing-bundles“. Ohne Produkte greifen die manuellen Blöcke."
    },
    {
      "type": "collection",
      "id": "bundles_collection",
      "label": "Paket-Kollektion"
    },
    {
      "type": "text",
      "id": "product_cta_label",
      "label": "Paket-Button: Text",
      "default": "Jetzt buchen"
    },
    {
      "type": "header",
      "content": "Inhalt"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Overline",
      "default": "Pakete"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Drei Pakete. Ein Anspruch."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Einleitung",
      "default": "Wähle das Paket, das zu deinem Fahrzeug passt – oder hol dir ein individuelles Angebot."
    },
    {
      "type": "text",
      "id": "custom_label",
      "label": "Individuelles Angebot: Button-Text",
      "default": "Individuelles Angebot anfragen"
    },
    {
      "type": "url",
      "id": "custom_url",
      "label": "Individuelles Angebot: Ziel"
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Hinweistext",
      "default": "Alle Preise inkl. 20 % USt. Richtpreise für PKW der Kompaktklasse – SUV, Van und stark verschmutzte Fahrzeuge gegen Aufpreis."
    },
    {
      "type": "select",
      "id": "background",
      "label": "Hintergrund",
      "options": [
        { "value": "base", "label": "Standard (dunkel)" },
        { "value": "surface", "label": "Anthrazit" },
        { "value": "navy", "label": "Navy" }
      ],
      "default": "base"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Abstand oben",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Abstand unten",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Paket",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Paketname",
          "default": "Basic Pflege"
        },
        {
          "type": "text",
          "id": "tagline",
          "label": "Kurzbeschreibung",
          "default": "Der schnelle Frischekick"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Preis (Text)",
          "default": "ab € 89"
        },
        {
          "type": "text",
          "id": "price_note",
          "label": "Preiszusatz",
          "default": "pro Fahrzeug, inkl. USt."
        },
        {
          "type": "textarea",
          "id": "features",
          "label": "Leistungen (eine pro Zeile)",
          "default": "Außenwäsche per Hand\nInnenraum saugen & wischen\nScheiben innen & außen\nKunststoffpflege innen"
        },
        {
          "type": "checkbox",
          "id": "featured",
          "label": "Hervorheben",
          "default": false
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge-Text (bei Hervorhebung)",
          "default": "Beliebteste Wahl"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Button-Text",
          "default": "Paket anfragen"
        },
        {
          "type": "text",
          "id": "included_services",
          "label": "Enthaltene Leistungen (Produkt-Handles)",
          "info": "Kommagetrennt, z. B. handwaesche-exterieur,innenreinigung-komplett — werden auf der Buchungsseite vorausgewählt."
        },
        {
          "type": "url",
          "id": "cta_url",
          "label": "Button-Ziel",
          "info": "Leer lassen, um die globale Buchungs-URL zu verwenden."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Preis-Pakete",
      "category": "KlaroClean",
      "blocks": [
        { "type": "tier" },
        { "type": "tier", "settings": { "title": "Premium Detail", "tagline": "Gründlichkeit + Glanz", "price": "ab € 249", "featured": true, "features": "Alles aus Basic Pflege\nInnenreinigung komplett\nEinstufige Maschinenpolitur\nLack- & Felgenversiegelung" } },
        { "type": "tier", "settings": { "title": "Full Detail", "tagline": "Das Komplettprogramm", "price": "ab € 489", "features": "Alles aus Premium Detail\nMehrstufige Politur\nKeramikversiegelung Basis\nMotorraum- & Türfalzenreinigung" } }
      ]
    }
  ]
}
{% endschema %}
