{%- comment -%}
  sections/services-overview.liquid — Leistungs-Highlights als Karten (Startseite).

  Einzige Datenquelle: die gewählte Kollektion (Standard „detailing-services“).
  Es gibt KEINE manuellen Block-Fallbacks mehr — Leistungen werden
  ausschließlich aus den aktiven Produkten der Kollektion gerendert. Sind
  keine Produkte vorhanden (Kollektion leer / alle Produkte Entwurf oder
  gelöscht), erscheint ein Leerzustand. Pflege erfolgt zu 100 % im Admin.
{%- endcomment -%}

{%- liquid
  assign services_collection = section.settings.collection
  if services_collection == blank
    assign services_collection = collections['detailing-services']
  endif
-%}

<section class="section section--{{ section.settings.background }}"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <header class="section-head" data-reveal>
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="section-head__lead">{{ section.settings.text }}</p>
      {%- endif -%}
    </header>

    {%- if services_collection != blank and services_collection.products_count > 0 -%}
      <div class="grid" style="--cols: {{ section.settings.columns }}; --cols-md: 2;">
        {%- for product in services_collection.products limit: section.settings.products_limit -%}
          {%- assign delay = forloop.index0 | times: 0.08 -%}
          {% render 'service-card',
            product: product,
            cta_label: section.settings.product_cta_label,
            reveal_delay: delay
          %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="empty-state">{{ 'general.services_empty' | t }}</p>
    {%- endif -%}

    {%- if section.settings.cta_label != blank and section.settings.cta_url != blank -%}
      <div class="testimonials__more">
        {% render 'button', label: section.settings.cta_label, url: section.settings.cta_url, style: 'outline' %}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Leistungs-Übersicht",
  "settings": [
    {
      "type": "header",
      "content": "Leistungs-Quelle"
    },
    {
      "type": "paragraph",
      "content": "Leistungen werden aus den Produkten der Kollektion gezogen (Titel, Preis, Bild, Beschreibung aus dem Admin). Leer lassen = automatisch „detailing-services“. Ohne aktive Produkte erscheint ein Leerzustand."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Leistungs-Kollektion"
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Maximale Anzahl Produkte",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "text",
      "id": "product_cta_label",
      "label": "Produkt-Button: Text",
      "default": "Zur Buchung hinzufügen"
    },
    {
      "type": "header",
      "content": "Inhalt"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Overline",
      "default": "Unsere Leistungen"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Pflege, die man sieht."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Einleitung",
      "default": "Jede Behandlung in Handarbeit, mit professionellen Produkten – buchbar direkt online."
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Spalten (Desktop)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button unten: Text",
      "default": "Alle Leistungen ansehen"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button unten: Ziel"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Hintergrund",
      "options": [
        { "value": "base", "label": "Standard (dunkel)" },
        { "value": "surface", "label": "Anthrazit" },
        { "value": "navy", "label": "Navy" }
      ],
      "default": "base"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Abstand oben",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Abstand unten",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 96
    }
  ],
  "presets": [
    {
      "name": "Leistungs-Übersicht",
      "category": "KlaroClean"
    }
  ]
}
{% endschema %}
