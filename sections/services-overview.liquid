{%- comment -%}
  sections/services-overview.liquid — Leistungs-Highlights als Karten
  (Startseite).

  Leistungs-Quelle (Feature „Services als Produkte“):
  1. Im Theme-Editor gewählte Kollektion — sonst automatisch die Kollektion
     „detailing-services“ (Collection-Picker erlaubt keine Schema-Defaults).
  2. Hat die Kollektion Produkte, werden diese gerendert (Pflege im Admin).
  3. Fallback: manuelle Blöcke (bisheriges Verhalten), zuletzt Hinweistext.
{%- endcomment -%}

{%- liquid
  assign services_collection = section.settings.collection
  if services_collection == blank
    assign services_collection = collections['detailing-services']
  endif
  assign use_products = false
  if services_collection != blank and services_collection.products_count > 0
    assign use_products = true
  endif
-%}

<section class="section section--{{ section.settings.background }}"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <header class="section-head" data-reveal>
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="section-head__lead">{{ section.settings.text }}</p>
      {%- endif -%}
    </header>

    {%- if use_products -%}
      <div class="grid" style="--cols: {{ section.settings.columns }}; --cols-md: 2;">
        {%- for product in services_collection.products limit: section.settings.products_limit -%}
          {%- assign delay = forloop.index0 | times: 0.08 -%}
          {% render 'service-card',
            product: product,
            cta_label: section.settings.product_cta_label,
            reveal_delay: delay
          %}
        {%- endfor -%}
      </div>
    {%- elsif section.blocks.size > 0 -%}
      <div class="grid" style="--cols: {{ section.settings.columns }}; --cols-md: 2;">
        {%- for block in section.blocks -%}
          {%- assign delay = forloop.index0 | times: 0.08 -%}
          {% render 'service-card',
            icon: block.settings.icon,
            title: block.settings.title,
            text: block.settings.text,
            url: block.settings.url,
            link_label: block.settings.link_label,
            attrs: block.shopify_attributes,
            reveal_delay: delay
          %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="lead">{{ 'booking.collection_empty' | t }}</p>
    {%- endif -%}

    {%- if section.settings.cta_label != blank and section.settings.cta_url != blank -%}
      <div class="testimonials__more">
        {% render 'button', label: section.settings.cta_label, url: section.settings.cta_url, style: 'outline' %}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Leistungs-Übersicht",
  "settings": [
    {
      "type": "header",
      "content": "Leistungs-Quelle"
    },
    {
      "type": "paragraph",
      "content": "Mit Kollektion werden Leistungen als Produkte aus dem Admin gezogen (Titel, Preis, Bild, Beschreibung). Leer = automatisch „detailing-services“. Ohne Produkte greifen die manuellen Blöcke."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Leistungs-Kollektion"
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Maximale Anzahl Produkte",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "text",
      "id": "product_cta_label",
      "label": "Produkt-Button: Text",
      "default": "Zur Buchung hinzufügen"
    },
    {
      "type": "header",
      "content": "Inhalt"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Overline",
      "default": "Unsere Leistungen"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Pflege, die man sieht."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Einleitung",
      "default": "Vom gründlichen Frühjahrsputz bis zur mehrjährigen Keramikversiegelung – jede Behandlung in Handarbeit, mit professionellen Produkten."
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Spalten (Desktop)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button unten: Text",
      "default": "Alle Leistungen ansehen"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button unten: Ziel"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Hintergrund",
      "options": [
        { "value": "base", "label": "Standard (dunkel)" },
        { "value": "surface", "label": "Anthrazit" },
        { "value": "navy", "label": "Navy" }
      ],
      "default": "base"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Abstand oben",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Abstand unten",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Leistung",
      "limit": 8,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "Kein Icon" },
            { "value": "droplet", "label": "Wassertropfen" },
            { "value": "seat", "label": "Sitz / Innenraum" },
            { "value": "sparkles", "label": "Glanz" },
            { "value": "shield", "label": "Schutzschild" },
            { "value": "beam", "label": "Scheinwerfer" },
            { "value": "car", "label": "Auto" },
            { "value": "gem", "label": "Edelstein" },
            { "value": "heart", "label": "Herz" }
          ],
          "default": "sparkles"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titel",
          "default": "Außenreinigung"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Beschreibung",
          "default": "Schonende Handwäsche, Felgenpflege und Lackreinigung – gründlicher, als es jede Waschanlage kann."
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link-Ziel"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link-Text",
          "default": "Mehr erfahren"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Leistungs-Übersicht",
      "category": "KlaroClean",
      "blocks": [
        { "type": "service" },
        { "type": "service", "settings": { "icon": "seat", "title": "Innenreinigung", "text": "Tiefenreinigung für Sitze, Teppiche und alle Oberflächen. Dein Innenraum – frisch wie am ersten Tag." } },
        { "type": "service", "settings": { "icon": "sparkles", "title": "Politur & Lackpflege", "text": "Mehrstufige Politur entfernt Kratzer, Hologramme und Mattigkeit – für ein spiegelglattes Finish." } },
        { "type": "service", "settings": { "icon": "shield", "title": "Keramikversiegelung", "text": "Langzeitschutz mit extremem Glanz und Abperleffekt – die Königsklasse der Lackpflege." } }
      ]
    }
  ]
}
{% endschema %}
