{%- comment -%}
  sections/footer.liquid — Footer mit fünf Spalten (Desktop):
  Marke · Leistungen · Unternehmen · Kontakt · Folge uns (+ Newsletter).
  Darunter: Zahlungsarten (offizielle Shopify-Badges) und Rechtliches.

  - Newsletter nutzt Shopifys Kunden-Formular (form 'customer') — keine App nötig.
  - Zahlungsarten kommen aus shop.enabled_payment_types (immer aktuell,
    offizielle Marken-SVGs via payment_type_svg_tag).
  - Rechtliches: gewähltes Menü, sonst automatisch alle veröffentlichten
    Shop-Richtlinien (Impressum, AGB, Datenschutz, Widerruf …).
{%- endcomment -%}

<footer class="site-footer">
  <div class="page-width">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        {%- if section.settings.logo != blank -%}
          {{ section.settings.logo | image_url: width: 320 | image_tag: widths: '160, 320', style: 'width: 150px', alt: shop.name }}
        {%- else -%}
          <span class="site-header__wordmark">Klaro<span class="accent">Clean</span></span>
        {%- endif -%}

        {%- if section.settings.blurb != blank -%}
          <p class="site-footer__blurb">{{ section.settings.blurb }}</p>
        {%- endif -%}
      </div>

      {%- if section.settings.menu_2 != blank -%}
        <nav aria-label="{{ section.settings.menu_2_heading | escape }}">
          <h2 class="site-footer__heading">{{ section.settings.menu_2_heading }}</h2>
          <ul class="site-footer__list">
            {%- for link in section.settings.menu_2.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}

      {%- if section.settings.menu != blank -%}
        <nav aria-label="{{ section.settings.menu_heading | escape }}">
          <h2 class="site-footer__heading">{{ section.settings.menu_heading }}</h2>
          <ul class="site-footer__list">
            {%- for link in section.settings.menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}

      <div>
        <h2 class="site-footer__heading">{{ section.settings.contact_heading }}</h2>
        <div class="site-footer__contact">
          {%- if settings.contact_phone != blank -%}
            <div>
              {%- render 'icon', name: 'phone', size: 18 -%}
              <a href="tel:{{ settings.contact_phone | replace: ' ', '' }}">{{ settings.contact_phone }}</a>
            </div>
          {%- endif -%}
          {%- if settings.contact_email != blank -%}
            <div>
              {%- render 'icon', name: 'mail', size: 18 -%}
              <a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a>
            </div>
          {%- endif -%}
          {%- if settings.contact_address != blank -%}
            <div>
              {%- render 'icon', name: 'map-pin', size: 18 -%}
              <span>{{ settings.contact_address | newline_to_br }}</span>
            </div>
          {%- endif -%}
          {%- if settings.contact_hours != blank -%}
            <div>
              {%- render 'icon', name: 'clock', size: 18 -%}
              <span>{{ settings.contact_hours | newline_to_br }}</span>
            </div>
          {%- endif -%}
        </div>
      </div>

      <div>
        <h2 class="site-footer__heading">{{ section.settings.follow_heading }}</h2>
        <div class="social-row">
          {%- if settings.social_instagram != blank -%}
            <a class="social-row__link" href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">
              {%- render 'icon', name: 'instagram', size: 20 -%}
            </a>
          {%- endif -%}
          {%- if settings.social_tiktok != blank -%}
            <a class="social-row__link" href="{{ settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">
              {%- render 'icon', name: 'tiktok', size: 20 -%}
            </a>
          {%- endif -%}
        </div>

        {%- if section.settings.show_newsletter -%}
          <div class="newsletter">
            <h2 class="site-footer__heading">{{ section.settings.newsletter_heading }}</h2>
            {%- comment -%}
              form 'customer' = Shopifys Newsletter-Anmeldung: legt die Adresse
              als Kund:in mit Marketing-Einwilligung an (Tag „newsletter“).
            {%- endcomment -%}
            {%- form 'customer', id: 'FooterNewsletter', class: 'newsletter-form' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              {%- if form.posted_successfully? -%}
                <p class="newsletter-form__success" role="status">{{ 'newsletter.success' | t }}</p>
              {%- else -%}
                {%- if form.errors -%}
                  <p class="newsletter-form__error" role="alert">{{ 'newsletter.error' | t }}</p>
                {%- endif -%}
                <div class="newsletter-form__row">
                  <label class="visually-hidden" for="FooterNewsletterEmail">{{ 'newsletter.label' | t }}</label>
                  <input class="field__input" type="email" id="FooterNewsletterEmail"
                    name="contact[email]" placeholder="{{ 'newsletter.placeholder' | t }}"
                    autocomplete="email" required>
                  <button class="btn btn--primary btn--sm" type="submit">{{ 'newsletter.submit' | t }}</button>
                </div>
              {%- endif -%}
            {%- endform -%}
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- if section.settings.show_payment and shop.enabled_payment_types.size > 0 -%}
      <div class="site-footer__payments" aria-label="Akzeptierte Zahlungsarten">
        {%- for type in shop.enabled_payment_types -%}
          {{ type | payment_type_svg_tag: class: 'payment-icon' }}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="site-footer__bottom">
      <span>© {{ 'now' | date: '%Y' }} {{ shop.name }}. Alle Rechte vorbehalten.</span>
      <nav aria-label="Rechtliches">
        <ul class="site-footer__legal">
          {%- if section.settings.legal_menu != blank -%}
            {%- for link in section.settings.legal_menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- else -%}
            {%- comment -%} Fallback: alle veröffentlichten Shop-Richtlinien {%- endcomment -%}
            {%- for policy in shop.policies -%}
              {%- if policy != blank -%}
                <li><a href="{{ policy.url }}">{{ policy.title }}</a></li>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </ul>
      </nav>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "shopify-section-footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer-Logo"
    },
    {
      "type": "textarea",
      "id": "blurb",
      "label": "Kurzbeschreibung",
      "default": "Professionelle Fahrzeugaufbereitung aus Innsbruck. Handarbeit, Präzision und Produkte, denen wir selbst vertrauen."
    },
    {
      "type": "header",
      "content": "Spalte: Leistungen"
    },
    {
      "type": "text",
      "id": "menu_2_heading",
      "label": "Überschrift",
      "default": "Leistungen"
    },
    {
      "type": "link_list",
      "id": "menu_2",
      "label": "Menü"
    },
    {
      "type": "header",
      "content": "Spalte: Unternehmen"
    },
    {
      "type": "text",
      "id": "menu_heading",
      "label": "Überschrift",
      "default": "Unternehmen"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menü",
      "default": "footer"
    },
    {
      "type": "header",
      "content": "Spalte: Kontakt"
    },
    {
      "type": "text",
      "id": "contact_heading",
      "label": "Überschrift",
      "default": "Kontakt"
    },
    {
      "type": "paragraph",
      "content": "Telefon, E-Mail, Adresse und Zeiten werden zentral unter Theme-Einstellungen → Kontaktdaten gepflegt."
    },
    {
      "type": "header",
      "content": "Spalte: Folge uns & Newsletter"
    },
    {
      "type": "text",
      "id": "follow_heading",
      "label": "Überschrift",
      "default": "Folge uns"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Newsletter-Anmeldung anzeigen",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter: Überschrift",
      "default": "Newsletter"
    },
    {
      "type": "header",
      "content": "Zahlungsarten & Rechtliches"
    },
    {
      "type": "checkbox",
      "id": "show_payment",
      "label": "Zahlungsarten anzeigen",
      "default": true,
      "info": "Zeigt automatisch die im Shop aktivierten Zahlungsarten (offizielle Badges)."
    },
    {
      "type": "link_list",
      "id": "legal_menu",
      "label": "Menü Rechtliches (Impressum, AGB, Datenschutz, Widerruf)",
      "info": "Leer = automatisch alle veröffentlichten Shop-Richtlinien."
    }
  ]
}
{% endschema %}
