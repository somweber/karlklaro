{%- comment -%}
  sections/footer.liquid — Footer mit Markenblock, zwei Menüs,
  Kontaktdaten (aus Theme-Einstellungen) und Rechtliches-Leiste.
{%- endcomment -%}

<footer class="site-footer">
  <div class="page-width">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        {%- if section.settings.logo != blank -%}
          {{ section.settings.logo | image_url: width: 320 | image_tag: widths: '160, 320', style: 'width: 150px', alt: shop.name }}
        {%- else -%}
          <span class="site-header__wordmark">Klaro<span class="accent">Clean</span></span>
        {%- endif -%}

        {%- if section.settings.blurb != blank -%}
          <p class="site-footer__blurb">{{ section.settings.blurb }}</p>
        {%- endif -%}

        <div class="social-row">
          {%- if settings.social_instagram != blank -%}
            <a class="social-row__link" href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">
              {%- render 'icon', name: 'instagram', size: 20 -%}
            </a>
          {%- endif -%}
          {%- if settings.social_facebook != blank -%}
            <a class="social-row__link" href="{{ settings.social_facebook }}" target="_blank" rel="noopener" aria-label="Facebook">
              {%- render 'icon', name: 'facebook', size: 20 -%}
            </a>
          {%- endif -%}
          {%- if settings.social_whatsapp != blank -%}
            <a class="social-row__link" href="{{ settings.social_whatsapp }}" target="_blank" rel="noopener" aria-label="WhatsApp">
              {%- render 'icon', name: 'whatsapp', size: 20 -%}
            </a>
          {%- endif -%}
          {%- if settings.maps_link != blank -%}
            <a class="social-row__link" href="{{ settings.maps_link }}" target="_blank" rel="noopener" aria-label="Google Maps">
              {%- render 'icon', name: 'map-pin', size: 20 -%}
            </a>
          {%- endif -%}
        </div>
      </div>

      {%- if section.settings.menu != blank -%}
        <nav aria-label="Footer-Navigation">
          <h2 class="site-footer__heading">{{ section.settings.menu_heading }}</h2>
          <ul class="site-footer__list">
            {%- for link in section.settings.menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}

      {%- if section.settings.menu_2 != blank -%}
        <nav aria-label="Leistungs-Navigation">
          <h2 class="site-footer__heading">{{ section.settings.menu_2_heading }}</h2>
          <ul class="site-footer__list">
            {%- for link in section.settings.menu_2.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}

      <div>
        <h2 class="site-footer__heading">{{ section.settings.contact_heading }}</h2>
        <div class="site-footer__contact">
          {%- if settings.contact_phone != blank -%}
            <div>
              {%- render 'icon', name: 'phone', size: 18 -%}
              <a href="tel:{{ settings.contact_phone | replace: ' ', '' }}">{{ settings.contact_phone }}</a>
            </div>
          {%- endif -%}
          {%- if settings.contact_email != blank -%}
            <div>
              {%- render 'icon', name: 'mail', size: 18 -%}
              <a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a>
            </div>
          {%- endif -%}
          {%- if settings.contact_address != blank -%}
            <div>
              {%- render 'icon', name: 'map-pin', size: 18 -%}
              <span>{{ settings.contact_address | newline_to_br }}</span>
            </div>
          {%- endif -%}
          {%- if settings.contact_hours != blank -%}
            <div>
              {%- render 'icon', name: 'clock', size: 18 -%}
              <span>{{ settings.contact_hours | newline_to_br }}</span>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>

    <div class="site-footer__bottom">
      <span>© {{ 'now' | date: '%Y' }} {{ shop.name }}. Alle Rechte vorbehalten.</span>
      {%- if section.settings.legal_menu != blank -%}
        <nav aria-label="Rechtliches">
          <ul class="site-footer__legal">
            {%- for link in section.settings.legal_menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "shopify-section-footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer-Logo"
    },
    {
      "type": "textarea",
      "id": "blurb",
      "label": "Kurzbeschreibung",
      "default": "Professionelle Fahrzeugaufbereitung aus Innsbruck. Handarbeit, Präzision und Produkte, denen wir selbst vertrauen."
    },
    {
      "type": "header",
      "content": "Menü 1"
    },
    {
      "type": "text",
      "id": "menu_heading",
      "label": "Überschrift",
      "default": "Navigation"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menü",
      "default": "footer"
    },
    {
      "type": "header",
      "content": "Menü 2 (optional)"
    },
    {
      "type": "text",
      "id": "menu_2_heading",
      "label": "Überschrift",
      "default": "Leistungen"
    },
    {
      "type": "link_list",
      "id": "menu_2",
      "label": "Menü"
    },
    {
      "type": "header",
      "content": "Kontakt-Spalte"
    },
    {
      "type": "text",
      "id": "contact_heading",
      "label": "Überschrift",
      "default": "Kontakt"
    },
    {
      "type": "paragraph",
      "content": "Telefon, E-Mail, Adresse und Zeiten werden zentral unter Theme-Einstellungen → Kontaktdaten gepflegt."
    },
    {
      "type": "header",
      "content": "Rechtliches"
    },
    {
      "type": "link_list",
      "id": "legal_menu",
      "label": "Menü (Impressum, Datenschutz, AGB)"
    }
  ]
}
{% endschema %}
