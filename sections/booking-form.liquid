{%- comment -%}
  sections/booking-form.liquid — Terminbuchung in 3 Schritten.

  Zwei Modi (Einstellung „Buchungsmodus“, Standard: automatisch):

  ● Warenkorb-Buchung (Feature „Mehrere Leistungen pro Buchung“):
    Leistungen kommen als Produkte aus einer Kollektion (Standard:
    „detailing-services“). Kund:innen wählen mehrere Leistungen als
    Checkbox-Karten, sehen Zwischensumme + Gesamtdauer im Summary-Panel
    und landen per AJAX Cart API (/cart/add.js) mit allen Leistungen als
    separate Positionen im Warenkorb/Checkout. Wunschtermin, Fahrzeug,
    Kennzeichen und Telefon werden als Line-Item-Properties an jeder
    Position gespeichert, das Buchungsdatum zusätzlich als Cart-Attribut.

  ● Anfrage-Formular (bisheriges Verhalten, automatischer Fallback ohne
    Produkte): Shopifys Kontaktformular — funktioniert ohne JS und ohne
    Produkte; Cowlendar-App-Blöcke ("@app") werden in beiden Modi gerendert.
{%- endcomment -%}

{%- liquid
  assign vehicle_options = section.settings.vehicle_options | newline_to_br | split: '<br />'
  assign time_options = section.settings.time_options | newline_to_br | split: '<br />'
  assign aside_steps = section.settings.aside_steps | newline_to_br | split: '<br />'

  # Leistungs-Quelle wie in den Services-Sections
  assign services_collection = section.settings.services_collection
  if services_collection == blank
    assign services_collection = collections['detailing-services']
  endif

  # Paket-Quelle: echte Bundle-Produkte (custom.bundle_includes verweist
  # auf die enthaltenen Leistungs-Produkte). Handle-Textfeld statt zweitem
  # Collection-Picker: Shopify erlaubt nur EIN collection-Setting pro Section.
  assign bundles_handle = section.settings.bundles_collection_handle | default: 'detailing-bundles'
  assign bundles_collection = collections[bundles_handle]
  assign has_bundles = false
  if bundles_collection != blank and bundles_collection.products_count > 0
    assign has_bundles = true
  endif

  # Modus auflösen: auto → Warenkorb, sobald Produkte existieren
  assign mode = section.settings.mode
  if mode == 'auto'
    if services_collection != blank and services_collection.products_count > 0
      assign mode = 'cart'
    else
      assign mode = 'form'
    endif
  elsif mode == 'cart'
    unless services_collection != blank and services_collection.products_count > 0
      assign mode = 'form'
    endunless
  endif

  assign redirect_path = '/checkout'
  if section.settings.redirect == 'cart'
    assign redirect_path = routes.cart_url
  endif

  # Kalender-Verfügbarkeit, zwei Quellen:
  # 1. booking.blocked_dates (Liste) — MANUELLE Sperren (Urlaub, Krankheit)
  # 2. booking.daily_bookings (json, Map "YYYY-MM-DD" → Anzahl) — Zähler;
  #    ein Tag ist erst „ausgebucht“, wenn die Kapazität (Einstellung,
  #    Standard 3 parallele Termine) erreicht ist. Pflege siehe MIGRATION.md.
  assign blocked_dates_json = '[]'
  if shop.metafields.booking.blocked_dates.value != blank
    assign blocked_dates_json = shop.metafields.booking.blocked_dates.value | json
  endif
  assign daily_bookings_json = '{}'
  if shop.metafields.booking.daily_bookings.value != blank
    assign daily_bookings_json = shop.metafields.booking.daily_bookings.value | json
  endif
-%}

<section class="section"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <div class="booking-layout">

      <div class="booking-card">
        {%- comment -%} App-Blöcke (z. B. Cowlendar-Kalender) erscheinen vor dem Formular {%- endcomment -%}
        {%- for block in section.blocks -%}
          {%- if block.type == '@app' -%}
            <div {{ block.shopify_attributes }}>{% render block %}</div>
          {%- endif -%}
        {%- endfor -%}

        {%- if mode == 'cart' -%}

          {%- comment -%}
            Ausgebuchte Termine fürs Frontend (Drei-Zustands-Kalender).
            Quelle: Shop-Metafeld booking.blocked_dates (Liste von Daten,
            Pflege im Admin — siehe MIGRATION.md).
          {%- endcomment -%}
          <script>
            window.KlaroClean = window.KlaroClean || {};
            window.KlaroClean.bookedDates = {{ blocked_dates_json }};
            window.KlaroClean.dailyBookings = {{ daily_bookings_json }};
          </script>

          {%- comment -%} Konfiguration & Strings für assets/main.js {%- endcomment -%}
          <script type="application/json" data-booking-config>
            {
              "cartAddUrl": {{ routes.cart_add_url | append: '.js' | json }},
              "cartUpdateUrl": {{ routes.cart_update_url | append: '.js' | json }},
              "redirect": {{ redirect_path | json }},
              "currency": {{ cart.currency.iso_code | json }},
              "maxDays": {{ section.settings.booking_window_days | default: 90 }},
              "capacity": {{ section.settings.booking_capacity | default: 3 }},
              "blockedDates": {{ blocked_dates_json }},
              "dailyBookings": {{ daily_bookings_json }},
              "strings": {
                "approx": {{ 'booking.approx' | t | json }},
                "hour": {{ 'booking.hours_short' | t | json }},
                "minute": {{ 'booking.minutes_short' | t | json }},
                "errorNoService": {{ 'booking.error_no_service' | t | json }},
                "errorDate": {{ 'booking.error_date' | t | json }},
                "errorAdd": {{ 'booking.error_add' | t | json }},
                "adding": {{ 'booking.adding' | t | json }},
                "booked": {{ 'booking.legend_booked' | t | json }},
                "slotsOne": {{ 'booking.slots_one' | t | json }},
                "slotsOther": {{ 'booking.slots_other' | t | json }},
                "upsellTip": {{ 'booking.upsell_tip' | t | json }},
                "upsellHeadline": {{ 'booking.upsell_upgrade_headline' | t | json }},
                "upsellText": {{ 'booking.upsell_upgrade_text' | t | json }},
                "serviceSingular": {{ 'booking.service_singular' | t | json }},
                "servicePlural": {{ 'booking.service_plural' | t | json }}
              }
            }
          </script>

          <noscript>
            <p class="form-error">{{ 'booking.noscript' | t }}</p>
          </noscript>

          <div data-booking-cart>
            <ol class="booking-progress" data-booking-progress aria-hidden="true">
              <li class="booking-progress__item is-active">1. {{ 'booking.step_services' | t }}</li>
              <li class="booking-progress__item">2. {{ 'booking.step_date' | t }}</li>
              <li class="booking-progress__item">3. {{ 'booking.step_contact' | t }}</li>
            </ol>

            <div class="form-error" data-booking-error role="alert" tabindex="-1" hidden></div>

            <fieldset class="booking-step is-active" data-booking-step="1"
              data-next-label="{{ section.settings.next_to_date_label | escape }}">
              <legend>{{ 'booking.step_services' | t }}</legend>

              {%- if has_bundles -%}
                <h3 class="booking-subhead">{{ 'booking.bundles_heading' | t }}</h3>
                <div class="service-select-grid service-select-grid--bundles" data-bundle-grid role="group" aria-label="{{ 'booking.bundles_heading' | t }}">
                  {%- for product in bundles_collection.products -%}
                    {%- liquid
                      assign variant = product.selected_or_first_available_variant
                      assign duration_minutes = product.metafields.custom.duration_minutes.value | default: 0
                      assign short_text = product.metafields.custom.short_description.value | default: product.description | strip_html | truncate: 90
                      assign savings = product.metafields.custom.savings_label.value
                      assign includes = product.metafields.custom.bundle_includes.value
                      assign include_handles = ''
                      assign include_titles = ''
                      for inc in includes
                        assign include_handles = include_handles | append: inc.handle
                        assign include_titles = include_titles | append: inc.title
                        unless forloop.last
                          assign include_handles = include_handles | append: ','
                          assign include_titles = include_titles | append: ' · '
                        endunless
                      endfor
                    -%}
                    <label class="service-select service-select--bundle{% unless product.available %} service-select--soldout{% endunless %}">
                      <input type="checkbox" class="visually-hidden service-select__input"
                        value="{{ variant.id }}"
                        data-service-checkbox
                        data-bundle-checkbox
                        data-service-handle="{{ product.handle }}"
                        data-includes="{{ include_handles }}"
                        data-title="{{ product.title | escape }}"
                        data-price-cents="{{ variant.price }}"
                        data-duration="{{ duration_minutes }}"
                        aria-label="{{ product.title | escape }}, {{ variant.price | money }}"
                        {% unless product.available %}disabled data-soldout="1"{% endunless %}>
                      <span class="service-select__check" aria-hidden="true">
                        {%- render 'icon', name: 'check', size: 14 -%}
                      </span>
                      <span class="service-select__body">
                        <span class="service-select__title">
                          {{ product.title | escape }}
                          {%- if savings != blank %} <span class="service-select__badge">{{ savings | escape }}</span>{% endif -%}
                        </span>
                        {%- if short_text != blank -%}
                          <span class="service-select__desc">{{ short_text }}</span>
                        {%- endif -%}
                        {%- if include_titles != blank -%}
                          <span class="service-select__desc service-select__includes">{{ 'booking.bundle_contains' | t }} {{ include_titles }}</span>
                        {%- endif -%}
                        <span class="service-select__meta">
                          {{ variant.price | money }}
                          {%- if duration_minutes != 0 %} · {% render 'duration', minutes: duration_minutes %}{% endif -%}
                        </span>
                      </span>
                    </label>
                  {%- endfor -%}
                </div>
                <h3 class="booking-subhead">{{ 'booking.singles_heading' | t }}</h3>
              {%- endif -%}

              <div class="service-select-grid" data-service-grid role="group" aria-label="{{ 'booking.step_services' | t }}">
                {%- for product in services_collection.products -%}
                  {%- liquid
                    assign variant = product.selected_or_first_available_variant
                    assign duration_minutes = product.metafields.custom.duration_minutes.value | default: 0
                    assign short_text = product.metafields.custom.short_description.value | default: product.description | strip_html | truncate: 90
                  -%}
                  <label class="service-select{% unless product.available %} service-select--soldout{% endunless %}">
                    <input type="checkbox" class="visually-hidden service-select__input"
                      value="{{ variant.id }}"
                      data-service-checkbox
                      data-service-handle="{{ product.handle }}"
                      data-title="{{ product.title | escape }}"
                      data-price-cents="{{ variant.price }}"
                      data-duration="{{ duration_minutes }}"
                      aria-label="{{ product.title | escape }}, {{ variant.price | money }}"
                      {% unless product.available %}disabled data-soldout="1"{% endunless %}>
                    <span class="service-select__check" aria-hidden="true">
                      {%- render 'icon', name: 'check', size: 14 -%}
                    </span>
                    <span class="service-select__lock" data-bundle-lock hidden>{{ 'booking.in_bundle' | t }}</span>
                    {% render 'responsive-image',
                      image: product.featured_image,
                      alt: '',
                      sizes: '72px',
                      aspect: '1 / 1',
                      class: 'service-select__thumb',
                      placeholder: 'product-apparel-1'
                    %}
                    <span class="service-select__body">
                      <span class="service-select__title">{{ product.title | escape }}</span>
                      {%- if short_text != blank -%}
                        <span class="service-select__desc">{{ short_text }}</span>
                      {%- endif -%}
                      <span class="service-select__meta">
                        {{ variant.price | money }}
                        {%- if duration_minutes != 0 %} · {% render 'duration', minutes: duration_minutes %}{% endif -%}
                        {%- unless product.available %} · {{ 'booking.sold_out' | t }}{% endunless -%}
                      </span>
                    </span>
                  </label>
                {%- endfor -%}

                {%- if has_bundles -%}
                  {%- comment -%}
                    Sanfter Paket-Tipp (Feature „Upsell bei Einzelleistung“):
                    wird per JS unter die gewählte Karte verschoben; dezent,
                    schließbar, kommt nach Dismiss in derselben Session nicht
                    wieder (sessionStorage).
                  {%- endcomment -%}
                  <div class="upsell-tip" data-upsell-tip hidden>
                    <p class="upsell-tip__text" data-tip-text></p>
                    <div class="upsell-tip__actions">
                      <button class="btn btn--outline btn--sm" type="button" data-tip-accept>{{ 'booking.upsell_switch' | t }}</button>
                      <button class="upsell-tip__close" type="button" data-tip-dismiss aria-label="{{ 'booking.upsell_no' | t }}">
                        {%- render 'icon', name: 'close', size: 14 -%}
                      </button>
                    </div>
                  </div>
                {%- endif -%}
              </div>
            </fieldset>

            <fieldset class="booking-step" data-booking-step="2"
              data-next-label="{{ section.settings.next_to_contact_label | escape }}">
              <legend>{{ 'booking.step_date' | t }}</legend>

              <div class="form-grid">
                <div class="field field--full booking-calendar" data-booking-calendar>
                  <label class="field__label" for="BookingDate">{{ 'booking.field_date' | t }} <span class="req" aria-hidden="true">*</span></label>
                  {%- comment -%}
                    Natives Date-Input als Basis — main.js wertet es zum
                    Flatpickr-Wochenend-Kalender auf (Progressive Enhancement).
                  {%- endcomment -%}
                  <input class="field__input" type="date" id="BookingDate"
                    data-booking-date data-min-today required>
                  <p class="booking-hint">
                    {%- render 'icon', name: 'calendar', size: 17 -%}
                    {{ section.settings.weekend_note }}
                  </p>
                  {%- comment -%}
                    Legende = echte Information, kein Deko-Element: Die Swatches
                    nutzen exakt die Styles der Kalenderzellen, der Text bleibt
                    für Screenreader lesbar.
                  {%- endcomment -%}
                  <ul class="cal-legend">
                    <li><span class="cal-legend__swatch cal-legend__swatch--available" aria-hidden="true"></span>{{ 'booking.legend_available' | t }}</li>
                    <li><span class="cal-legend__swatch cal-legend__swatch--booked" aria-hidden="true"></span>{{ 'booking.legend_booked' | t }}</li>
                    <li><span class="cal-legend__swatch cal-legend__swatch--none" aria-hidden="true"></span>{{ 'booking.legend_none' | t }}</li>
                  </ul>
                </div>
                <div class="field">
                  <label class="field__label" for="BookingTime">{{ 'booking.field_time' | t }}</label>
                  <select class="field__input" id="BookingTime" data-booking-time>
                    {%- for option in time_options -%}
                      {%- assign opt = option | strip -%}
                      {%- if opt != blank -%}<option value="{{ opt | escape }}">{{ opt }}</option>{%- endif -%}
                    {%- endfor -%}
                  </select>
                </div>
              </div>
            </fieldset>

            <fieldset class="booking-step" data-booking-step="3">
              <legend>{{ 'booking.step_contact' | t }}</legend>

              <div class="form-grid">
                <div class="field">
                  <label class="field__label" for="BookingVehicle">{{ 'booking.field_vehicle' | t }} <span class="req" aria-hidden="true">*</span></label>
                  <select class="field__input" id="BookingVehicle" data-booking-vehicle required>
                    <option value="" disabled selected>{{ 'booking.choose' | t }}</option>
                    {%- for option in vehicle_options -%}
                      {%- assign opt = option | strip -%}
                      {%- if opt != blank -%}<option value="{{ opt | escape }}">{{ opt }}</option>{%- endif -%}
                    {%- endfor -%}
                  </select>
                </div>
                <div class="field">
                  <label class="field__label" for="BookingPlate">{{ 'booking.field_plate' | t }}</label>
                  <input class="field__input" type="text" id="BookingPlate" data-booking-plate
                    autocomplete="off" placeholder="I-123XY">
                  <span class="field__hint">{{ 'booking.field_plate_hint' | t }}</span>
                </div>
                <div class="field">
                  <label class="field__label" for="BookingPhone">{{ 'booking.field_phone' | t }} <span class="req" aria-hidden="true">*</span></label>
                  <input class="field__input" type="tel" id="BookingPhone" data-booking-phone
                    autocomplete="tel" required>
                </div>
                <div class="field field--full">
                  <label class="field__label" for="BookingNote">{{ 'booking.field_message' | t }}</label>
                  <textarea class="field__input" id="BookingNote" data-booking-note
                    placeholder="{{ section.settings.message_placeholder | escape }}"></textarea>
                </div>
                <div class="field field--full">
                  <label class="checkbox-field">
                    <input type="checkbox" data-booking-privacy required>
                    <span>Ich stimme zu, dass meine Angaben zur Bearbeitung der Buchung verarbeitet werden.
                      Details in der <a href="/policies/privacy-policy">Datenschutzerklärung</a>. <span class="req" aria-hidden="true">*</span></span>
                  </label>
                </div>
              </div>
            </fieldset>

            {%- if has_bundles -%}
              {%- comment -%}
                Smart-Upgrade-Banner (Feature „Empfehlung bei 2+ Leistungen“):
                als <details> mobil kollabierbar statt Overlay; erscheint nur,
                wenn Kund:in UND Geschäft profitieren (bundle-recommender.js).
              {%- endcomment -%}
              <details class="upsell-upgrade" data-upsell-upgrade hidden>
                <summary class="upsell-upgrade__summary">
                  <span aria-hidden="true">💡</span>
                  <span data-upsell-headline></span>
                  {%- render 'icon', name: 'chevron-down', size: 16 -%}
                </summary>
                <div class="upsell-upgrade__body">
                  <p data-upsell-text></p>
                  <div class="upsell-upgrade__actions">
                    <button class="btn btn--primary btn--sm" type="button" data-upsell-accept>{{ 'booking.upsell_switch' | t }}</button>
                    <button class="btn btn--ghost btn--sm" type="button" data-upsell-dismiss>{{ 'booking.upsell_no' | t }}</button>
                  </div>
                </div>
              </details>
            {%- endif -%}

            <div class="booking-nav">
              <button class="btn btn--outline" type="button" data-booking-prev hidden>{{ 'booking.back' | t }}</button>
              <button class="btn btn--primary" type="button" data-booking-next>{{ section.settings.next_to_date_label }}</button>
              <button class="btn btn--primary btn--lg" type="button" data-booking-submit hidden>
                <span data-booking-submit-label>{{ section.settings.submit_cart_label }}</span>
                {%- render 'icon', name: 'arrow-right', size: 18 -%}
              </button>
            </div>

            {%- if section.settings.response_note != blank -%}
              <p class="booking-hint">
                {%- render 'icon', name: 'clock', size: 17 -%}
                {{ section.settings.response_note }}
              </p>
            {%- endif -%}
          </div>

        {%- elsif section.settings.show_form -%}
          {%- form 'contact', id: 'BookingForm' -%}

            {%- if form.posted_successfully? -%}
              <div class="form-success" data-form-success role="status">
                <span class="icon-badge">{% render 'icon', name: 'check', size: 30 %}</span>
                <h2>{{ section.settings.success_heading }}</h2>
                <p class="text-muted">{{ section.settings.success_text }}</p>
                {% render 'button', label: section.settings.success_cta_label, url: routes.root_url, style: 'outline' %}
              </div>
            {%- else -%}

              {%- if form.errors -%}
                <div class="form-error" role="alert">
                  Deine Anfrage konnte nicht gesendet werden. Bitte überprüfe deine Angaben –
                  insbesondere die E-Mail-Adresse – und versuche es erneut.
                </div>
              {%- endif -%}

              {%- comment -%} Wrapper mit data-Attribut: Andockpunkt für den JS-Stepper {%- endcomment -%}
              <div data-booking-form>
                <ol class="booking-progress" data-booking-progress aria-hidden="true">
                  <li class="booking-progress__item is-active">1. Kontakt</li>
                  <li class="booking-progress__item">2. Fahrzeug & Leistung</li>
                  <li class="booking-progress__item">3. Termin</li>
                </ol>

                {%- comment -%} Kennzeichnung der Anfrage in der E-Mail-Benachrichtigung {%- endcomment -%}
                <input type="hidden" name="contact[Formular]" value="Terminanfrage">

                <fieldset class="booking-step is-active" data-booking-step="1">
                  <legend>Deine Kontaktdaten</legend>
                  <div class="form-grid">
                    <div class="field">
                      <label class="field__label" for="BookingName">Name <span class="req" aria-hidden="true">*</span></label>
                      <input class="field__input" type="text" id="BookingName" name="contact[name]"
                        autocomplete="name" required
                        value="{% if form.name %}{{ form.name }}{% endif %}">
                    </div>
                    <div class="field">
                      <label class="field__label" for="BookingEmail">E-Mail <span class="req" aria-hidden="true">*</span></label>
                      <input class="field__input" type="email" id="BookingEmail" name="contact[email]"
                        autocomplete="email" required
                        value="{% if form.email %}{{ form.email }}{% endif %}"
                        aria-invalid="{% if form.errors contains 'email' %}true{% else %}false{% endif %}">
                    </div>
                    <div class="field field--full">
                      <label class="field__label" for="BookingPhoneLegacy">Telefon</label>
                      <input class="field__input" type="tel" id="BookingPhoneLegacy" name="contact[phone]" autocomplete="tel">
                      <span class="field__hint">Für schnelle Rückfragen – optional.</span>
                    </div>
                  </div>
                </fieldset>

                <fieldset class="booking-step" data-booking-step="2">
                  <legend>Fahrzeug & Leistung</legend>
                  <div class="form-grid">
                    <div class="field">
                      <label class="field__label" for="BookingVehicleLegacy">Fahrzeugtyp <span class="req" aria-hidden="true">*</span></label>
                      <select class="field__input" id="BookingVehicleLegacy" name="contact[Fahrzeugtyp]" required>
                        <option value="" disabled selected>{{ 'booking.choose' | t }}</option>
                        {%- for option in vehicle_options -%}
                          {%- assign opt = option | strip -%}
                          {%- if opt != blank -%}<option value="{{ opt | escape }}">{{ opt }}</option>{%- endif -%}
                        {%- endfor -%}
                      </select>
                    </div>
                    <div class="field">
                      {%- comment -%} Freitext statt fester Optionen — keine Produktnamen im Code {%- endcomment -%}
                      <label class="field__label" for="BookingService">Gewünschte Leistung</label>
                      <input class="field__input" type="text" id="BookingService" name="contact[Leistung]"
                        autocomplete="off" placeholder="Deine Wunschleistung">
                    </div>
                  </div>
                </fieldset>

                <fieldset class="booking-step" data-booking-step="3">
                  <legend>Wunschtermin & Details</legend>
                  <div class="form-grid">
                    <div class="field">
                      <label class="field__label" for="BookingDateLegacy">Wunschtermin <span class="req" aria-hidden="true">*</span></label>
                      <input class="field__input" type="date" id="BookingDateLegacy" name="contact[Wunschtermin]" required data-min-today>
                    </div>
                    <div class="field">
                      <label class="field__label" for="BookingTimeLegacy">Tageszeit</label>
                      <select class="field__input" id="BookingTimeLegacy" name="contact[Tageszeit]">
                        {%- for option in time_options -%}
                          {%- assign opt = option | strip -%}
                          {%- if opt != blank -%}<option value="{{ opt | escape }}">{{ opt }}</option>{%- endif -%}
                        {%- endfor -%}
                      </select>
                    </div>
                    <div class="field field--full">
                      <label class="field__label" for="BookingMessage">Nachricht</label>
                      <textarea class="field__input" id="BookingMessage" name="contact[body]"
                        placeholder="{{ section.settings.message_placeholder | escape }}"></textarea>
                    </div>
                    <div class="field field--full">
                      <label class="checkbox-field">
                        <input type="checkbox" name="contact[Datenschutz]" value="zugestimmt" required>
                        <span>Ich stimme zu, dass meine Angaben zur Bearbeitung der Anfrage verarbeitet werden.
                          Details in der <a href="/policies/privacy-policy">Datenschutzerklärung</a>. <span class="req" aria-hidden="true">*</span></span>
                      </label>
                    </div>
                  </div>
                </fieldset>

                <div class="booking-nav">
                  <button class="btn btn--outline" type="button" data-booking-prev hidden>{{ 'booking.back' | t }}</button>
                  <button class="btn btn--primary" type="button" data-booking-next>Weiter</button>
                  <button class="btn btn--primary btn--lg" type="submit" data-booking-submit>
                    <span>Anfrage senden</span>
                    {%- render 'icon', name: 'send', size: 18 -%}
                  </button>
                </div>

                {%- if section.settings.response_note != blank -%}
                  <p class="booking-hint">
                    {%- render 'icon', name: 'clock', size: 17 -%}
                    {{ section.settings.response_note }}
                  </p>
                {%- endif -%}
              </div>

            {%- endif -%}
          {%- endform -%}
        {%- endif -%}
      </div>

      <aside class="booking-aside">
        {%- if mode == 'cart' -%}
          {%- comment -%}
            Summary-Panel: immer gerendert (kein Layout-Shift), Desktop sticky.
            aria-live informiert Screenreader über Auswahl-Änderungen.
          {%- endcomment -%}
          <div class="aside-card booking-summary" data-booking-summary aria-live="polite">
            <h3>{{ 'booking.summary_title' | t }}</h3>
            <p class="booking-summary__empty text-muted" data-summary-empty>{{ 'booking.summary_empty' | t }}</p>
            <ul class="booking-summary__list" data-summary-list hidden></ul>
            <div class="booking-summary__totals" data-summary-totals hidden>
              <div class="booking-summary__row">
                <span>{{ 'booking.subtotal' | t }}</span>
                <strong data-summary-subtotal></strong>
              </div>
              <div class="booking-summary__row">
                <span>{{ 'booking.duration_total' | t }}</span>
                <span data-summary-duration></span>
              </div>
              <div class="booking-summary__row" data-summary-date-row hidden>
                <span>{{ 'booking.selected_date' | t }}</span>
                <span data-summary-date></span>
              </div>
            </div>
          </div>
        {%- endif -%}

        <div class="aside-card">
          <h3>{{ section.settings.aside_contact_heading }}</h3>
          <p class="text-muted">{{ section.settings.aside_contact_text }}</p>
          {%- if settings.contact_phone != blank -%}
            <a class="cta-banner__phone" href="tel:{{ settings.contact_phone | replace: ' ', '' }}">
              {%- render 'icon', name: 'phone', size: 18 -%}{{ settings.contact_phone }}
            </a>
          {%- endif -%}
          {%- if settings.social_whatsapp != blank -%}
            <a class="cta-banner__phone" href="{{ settings.social_whatsapp }}" target="_blank" rel="noopener">
              {%- render 'icon', name: 'whatsapp', size: 18 -%}WhatsApp schreiben
            </a>
          {%- endif -%}
        </div>

        {%- if section.settings.aside_steps != blank -%}
          <div class="aside-card">
            <h3>{{ section.settings.aside_steps_heading }}</h3>
            <ol>
              {%- for step in aside_steps -%}
                {%- assign s = step | strip -%}
                {%- if s != blank -%}<li>{{ s }}</li>{%- endif -%}
              {%- endfor -%}
            </ol>
          </div>
        {%- endif -%}
      </aside>

    </div>
  </div>

  {%- if mode == 'cart' -%}
    {%- comment -%}
      Mobile Bottom-Bar: eingeklappt Summe + Weiter-CTA, per Tap aufklappbar
      (Liste der gewählten Leistungen). Blendet sich aus, sobald die echten
      Formular-Buttons sichtbar sind (IntersectionObserver in main.js).
    {%- endcomment -%}
    <div class="booking-minibar" data-booking-minibar>
      <div class="booking-minibar__panel" id="MinibarPanel" data-minibar-panel hidden>
        <ul class="booking-summary__list" data-minibar-list></ul>
      </div>
      <div class="booking-minibar__bar">
        <button class="booking-minibar__toggle" type="button" data-minibar-toggle
          aria-expanded="false" aria-controls="MinibarPanel">
          <strong data-minibar-count>0</strong>
          <span data-minibar-total></span>
          <span class="booking-minibar__duration" data-minibar-duration></span>
          {%- render 'icon', name: 'chevron-down', size: 18 -%}
        </button>
        <button class="btn btn--primary btn--sm" type="button" data-minibar-cta>
          {{- 'booking.continue' | t -}}
        </button>
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Buchungsformular",
  "settings": [
    {
      "type": "select",
      "id": "mode",
      "label": "Buchungsmodus",
      "options": [
        { "value": "auto", "label": "Automatisch (empfohlen)" },
        { "value": "cart", "label": "Warenkorb-Buchung" },
        { "value": "form", "label": "Anfrage-Formular (E-Mail)" }
      ],
      "default": "auto",
      "info": "Automatisch: Warenkorb-Buchung, sobald die Leistungs-Kollektion Produkte enthält – sonst Anfrage-Formular."
    },
    {
      "type": "collection",
      "id": "services_collection",
      "label": "Leistungs-Kollektion",
      "info": "Leer = automatisch „detailing-services“."
    },
    {
      "type": "text",
      "id": "bundles_collection_handle",
      "label": "Paket-Kollektion (Handle)",
      "default": "detailing-bundles",
      "info": "Handle der Paket-Kollektion. Textfeld statt Picker: Shopify erlaubt nur ein Kollektions-Setting pro Section."
    },
    {
      "type": "select",
      "id": "redirect",
      "label": "Nach der Buchung weiterleiten zu",
      "options": [
        { "value": "checkout", "label": "Checkout" },
        { "value": "cart", "label": "Warenkorb" }
      ],
      "default": "checkout"
    },
    {
      "type": "range",
      "id": "booking_window_days",
      "label": "Buchbarer Zeitraum",
      "min": 30,
      "max": 180,
      "step": 15,
      "unit": "Tg",
      "default": 90
    },
    {
      "type": "range",
      "id": "booking_capacity",
      "label": "Termine pro Tag (Kapazität)",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 3,
      "info": "Ein Tag gilt erst als ausgebucht, wenn booking.daily_bookings diese Anzahl erreicht."
    },
    {
      "type": "text",
      "id": "weekend_note",
      "label": "Hinweis unter dem Kalender",
      "default": "Termine sind nur am Wochenende verfügbar. Wir melden uns innerhalb von 24 Stunden zur Bestätigung."
    },
    {
      "type": "header",
      "content": "Beschriftungen (Warenkorb-Modus)"
    },
    {
      "type": "text",
      "id": "next_to_date_label",
      "label": "Button: weiter zu Schritt 2",
      "default": "Weiter zur Terminauswahl"
    },
    {
      "type": "text",
      "id": "next_to_contact_label",
      "label": "Button: weiter zu Schritt 3",
      "default": "Weiter zu deinen Daten"
    },
    {
      "type": "text",
      "id": "submit_cart_label",
      "label": "Button: Abschluss",
      "default": "Weiter zur Kasse"
    },
    {
      "type": "header",
      "content": "Anfrage-Formular (Fallback-Modus)"
    },
    {
      "type": "checkbox",
      "id": "show_form",
      "label": "Anfrage-Formular anzeigen",
      "default": true,
      "info": "Deaktivieren, wenn stattdessen ausschließlich ein Buchungs-App-Block (z. B. Cowlendar) verwendet wird."
    },
    {
      "type": "textarea",
      "id": "vehicle_options",
      "label": "Fahrzeugtypen (einer pro Zeile)",
      "default": "Kleinwagen\nLimousine\nKombi\nSUV\nVan / Bus\nMotorrad\nSonstiges"
    },
    {
      "type": "textarea",
      "id": "time_options",
      "label": "Tageszeiten (eine pro Zeile)",
      "default": "Flexibel\nVormittag\nNachmittag\nAbend"
    },
    {
      "type": "text",
      "id": "message_placeholder",
      "label": "Platzhalter Nachricht",
      "default": "Marke, Modell, Zustand – je mehr Details, desto besser."
    },
    {
      "type": "text",
      "id": "response_note",
      "label": "Hinweis unter dem Formular",
      "default": "Wir melden uns innerhalb von 24 Stunden mit einer Terminbestätigung."
    },
    {
      "type": "header",
      "content": "Erfolgsmeldung (Anfrage-Formular)"
    },
    {
      "type": "text",
      "id": "success_heading",
      "label": "Überschrift",
      "default": "Anfrage erhalten – danke!"
    },
    {
      "type": "textarea",
      "id": "success_text",
      "label": "Text",
      "default": "Wir prüfen deinen Wunschtermin und melden uns innerhalb von 24 Stunden bei dir. Schau in der Zwischenzeit gern in unsere Galerie."
    },
    {
      "type": "text",
      "id": "success_cta_label",
      "label": "Button-Text",
      "default": "Zurück zur Startseite"
    },
    {
      "type": "header",
      "content": "Seitenleiste"
    },
    {
      "type": "text",
      "id": "aside_contact_heading",
      "label": "Kontakt-Karte: Überschrift",
      "default": "Lieber direkt?"
    },
    {
      "type": "textarea",
      "id": "aside_contact_text",
      "label": "Kontakt-Karte: Text",
      "default": "Ruf uns an oder schreib uns – wir beraten dich gern persönlich."
    },
    {
      "type": "text",
      "id": "aside_steps_heading",
      "label": "Ablauf-Karte: Überschrift",
      "default": "So geht's weiter"
    },
    {
      "type": "textarea",
      "id": "aside_steps",
      "label": "Ablauf-Schritte (einer pro Zeile)",
      "default": "Du schickst uns deine Buchung.\nWir bestätigen Termin & Preis innerhalb von 24 Stunden.\nWir holen dein Auto ab oder du kommst vorbei."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Abstand oben",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Abstand unten",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Buchungsformular",
      "category": "KlaroClean"
    }
  ]
}
{% endschema %}
