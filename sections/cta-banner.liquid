{%- comment -%}
  sections/cta-banner.liquid — Abschluss-CTA („Bereit für das beste Ergebnis?“).
  Navy-Panel mit Akzent-Glow, Button + optionaler Telefon-Schnellkontakt.
{%- endcomment -%}

<section class="section"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <div class="cta-banner__inner{% if section.settings.align == 'center' %} cta-banner__inner--center{% endif %}" data-reveal>
      <h2>{{ section.settings.heading }}</h2>

      {%- if section.settings.text != blank -%}
        <p class="cta-banner__text">{{ section.settings.text }}</p>
      {%- endif -%}

      <div class="cta-banner__actions">
        {% render 'button', label: section.settings.cta_label, url: section.settings.cta_url, style: 'primary', size: 'lg', icon: 'arrow-right' %}

        {%- if section.settings.show_phone and settings.contact_phone != blank -%}
          <a class="cta-banner__phone" href="tel:{{ settings.contact_phone | replace: ' ', '' }}">
            {%- render 'icon', name: 'phone', size: 20 -%}
            {{ settings.contact_phone }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CTA-Banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Bereit für das beste Ergebnis?"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Sichere dir jetzt deinen Wunschtermin – wir kümmern uns um den Rest. Unverbindliche Anfrage, Antwort innerhalb von 24 Stunden."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button-Text",
      "default": "Jetzt Termin buchen"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button-Ziel",
      "default": "/pages/buchung"
    },
    {
      "type": "checkbox",
      "id": "show_phone",
      "label": "Telefonnummer anzeigen",
      "default": true,
      "info": "Nummer wird unter Theme-Einstellungen → Kontaktdaten gepflegt."
    },
    {
      "type": "select",
      "id": "align",
      "label": "Ausrichtung",
      "options": [
        { "value": "start", "label": "Links" },
        { "value": "center", "label": "Zentriert" }
      ],
      "default": "start"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Abstand oben",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Abstand unten",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 96
    }
  ],
  "presets": [
    {
      "name": "CTA-Banner",
      "category": "KlaroClean"
    }
  ]
}
{% endschema %}
