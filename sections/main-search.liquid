{%- comment -%}
  sections/main-search.liquid — Suchseite (Produkte, Seiten, Artikel).
{%- endcomment -%}

<section class="section" style="--pt: 48px; --pb: 96px;">
  <div class="page-width">
    <header class="section-head">
      <h1>{{ 'search.title' | t }}</h1>
      <form action="{{ routes.search_url }}" method="get" role="search"
        style="display: flex; gap: var(--space-sm); max-width: 560px;">
        <label class="visually-hidden" for="SearchInput">{{ 'search.placeholder' | t }}</label>
        <input class="field__input" type="search" id="SearchInput" name="q"
          value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}">
        <button class="btn btn--primary" type="submit" aria-label="{{ 'search.submit' | t }}">
          {%- render 'icon', name: 'search', size: 20 -%}
        </button>
      </form>
    </header>

    {%- if search.performed -%}
      {%- if search.results_count == 0 -%}
        <p class="lead">{{ 'search.no_results' | t: terms: search.terms }}</p>
      {%- else -%}
        {%- paginate search.results by 12 -%}
          <p class="text-muted" style="margin-bottom: var(--space-xl);">
            {{ 'search.results_count' | t: count: search.results_count, terms: search.terms }}
          </p>

          <div class="grid" style="--cols: 4; --cols-md: 2;">
            {%- for item in search.results -%}
              {%- case item.object_type -%}
                {%- when 'product' -%}
                  {% render 'product-card', product: item %}
                {%- when 'article' -%}
                  <a class="article-card" href="{{ item.url }}">
                    {% render 'responsive-image', image: item.image, alt: item.title, sizes: '(min-width: 990px) 300px, 45vw', placeholder: 'lifestyle-1' %}
                    <h2 class="product-card__title">{{ item.title | escape }}</h2>
                  </a>
                {%- else -%}
                  <a class="product-card" href="{{ item.url }}">
                    <h2 class="product-card__title">{{ item.title | escape }}</h2>
                    <p class="product-card__price">{{ item.content | strip_html | truncate: 90 }}</p>
                  </a>
              {%- endcase -%}
            {%- endfor -%}
          </div>

          {% render 'pagination', paginate: paginate %}
        {%- endpaginate -%}
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Suche",
  "settings": []
}
{% endschema %}
