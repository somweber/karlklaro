{%- comment -%}
  sections/main-collection.liquid — Produktliste einer Kollektion.
{%- endcomment -%}

<section class="section" style="--pt: 48px; --pb: 96px;">
  <div class="page-width">
    <header class="section-head collection-banner">
      <h1>{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <div class="rte">{{ collection.description }}</div>
      {%- endif -%}
    </header>

    {%- paginate collection.products by 12 -%}
      {%- if collection.products.size > 0 -%}
        <div class="grid" style="--cols: 4; --cols-md: 2;">
          {%- for product in collection.products -%}
            {% render 'product-card', product: product %}
          {%- endfor -%}
        </div>
        {% render 'pagination', paginate: paginate %}
      {%- else -%}
        <p class="lead">{{ 'collections.empty' | t }}</p>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Kollektion",
  "settings": []
}
{% endschema %}
