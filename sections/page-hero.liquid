{%- comment -%}
  sections/page-hero.liquid — Kopfbereich für Unterseiten.
  Enthält das H1 der Seite; bleibt die Überschrift leer,
  wird automatisch der Seitentitel aus Shopify verwendet.
{%- endcomment -%}

{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = page.title
  endif
-%}

<section class="page-hero{% if section.settings.compact %} page-hero--compact{% endif %}">
  <div class="page-width">
    <div class="page-hero__inner" data-reveal>
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1>{{ heading }}</h1>
      {%- if section.settings.text != blank -%}
        <p class="lead">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Seiten-Kopf",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Overline"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift (H1)",
      "info": "Leer lassen, um den Seitentitel zu verwenden."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Einleitung"
    },
    {
      "type": "checkbox",
      "id": "compact",
      "label": "Kompakte Höhe",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Seiten-Kopf",
      "category": "KlaroClean"
    }
  ]
}
{% endschema %}
