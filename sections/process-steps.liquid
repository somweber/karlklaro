{%- comment -%}
  sections/process-steps.liquid — „So funktioniert's“: nummerierter
  3-Schritte-Prozess (Anfrage → Termin → Ergebnis).
{%- endcomment -%}

<section class="section section--{{ section.settings.background }}"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <header class="section-head" data-reveal>
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="section-head__lead">{{ section.settings.text }}</p>
      {%- endif -%}
    </header>

    <ol class="steps">
      {%- for block in section.blocks -%}
        <li class="step" data-reveal style="--reveal-delay: {{ forloop.index0 | times: 0.1 }}s" {{ block.shopify_attributes }}>
          {%- comment -%} Führende Null für den technischen Look: 01 / 02 / 03 {%- endcomment -%}
          <span class="step__num" aria-hidden="true">{{ forloop.index | prepend: '0' }}</span>
          <h3>{{ block.settings.title | escape }}</h3>
          <p class="step__text">{{ block.settings.text }}</p>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Prozess-Schritte",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Overline",
      "default": "So funktioniert's"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "In drei Schritten zum perfekten Ergebnis."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Einleitung"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Hintergrund",
      "options": [
        { "value": "base", "label": "Standard (dunkel)" },
        { "value": "surface", "label": "Anthrazit" },
        { "value": "navy", "label": "Navy" }
      ],
      "default": "base"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Abstand oben",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Abstand unten",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Schritt",
      "limit": 5,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Titel",
          "default": "Anfrage senden"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Beschreibung",
          "default": "Wähle deine Wunschleistung und schick uns deine Anfrage – online in zwei Minuten erledigt."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Prozess-Schritte",
      "category": "KlaroClean",
      "blocks": [
        { "type": "step" },
        { "type": "step", "settings": { "title": "Termin bestätigen", "text": "Wir melden uns innerhalb von 24 Stunden und fixieren deinen Wunschtermin – bei dir vor Ort oder bei uns." } },
        { "type": "step", "settings": { "title": "Ergebnis genießen", "text": "Du übernimmst dein Auto in neuwertigem Zustand – auf Wunsch mit Pflege-Tipps für danach." } }
      ]
    }
  ]
}
{% endschema %}
