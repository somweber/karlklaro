{%- comment -%}
  sections/main-404.liquid — Gebrandete Fehlerseite.
{%- endcomment -%}

<section class="section">
  <div class="page-width status-page">
    <p class="status-page__code" aria-hidden="true">404</p>
    <h1>{{ section.settings.heading }}</h1>
    <p class="lead">{{ section.settings.text }}</p>
    <div class="status-page__actions">
      {% render 'button', label: section.settings.cta_label, url: routes.root_url, style: 'primary', icon: 'arrow-right' %}
      {% render 'button', label: section.settings.cta_2_label, url: section.settings.cta_2_url, style: 'outline' %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "404-Seite",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Diese Seite glänzt (noch) nicht."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Die angeforderte Seite existiert nicht oder wurde verschoben. Kein Problem – wir bringen dich zurück auf Kurs."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button: Text",
      "default": "Zurück zur Startseite"
    },
    {
      "type": "text",
      "id": "cta_2_label",
      "label": "Zweiter Button: Text",
      "default": "Leistungen ansehen"
    },
    {
      "type": "url",
      "id": "cta_2_url",
      "label": "Zweiter Button: Ziel"
    }
  ]
}
{% endschema %}
