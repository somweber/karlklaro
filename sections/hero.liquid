{%- comment -%}
  sections/hero.liquid — Vollbild-Hero (Startseite).
  Enthält das H1 der Seite — pro Seite nur einmal verwenden (SEO).
  Bild lädt eager + fetchpriority=high (Largest Contentful Paint).
{%- endcomment -%}

<section class="hero hero--{{ section.settings.height }}">
  <div class="hero__media">
    {% render 'responsive-image',
      image: section.settings.image,
      alt: section.settings.image_alt,
      sizes: '100vw',
      loading: 'eager',
      placeholder: 'lifestyle-2',
      class: 'media--plain'
    %}
  </div>
  <div class="hero__overlay" style="--overlay: {{ section.settings.overlay }};"></div>

  <div class="page-width hero__content">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    <h1 class="hero__title">{{ section.settings.heading }}</h1>

    {%- if section.settings.text != blank -%}
      <p class="hero__lead">{{ section.settings.text }}</p>
    {%- endif -%}

    <div class="hero__actions">
      {% render 'button', label: section.settings.cta_primary_label, url: section.settings.cta_primary_url, style: 'primary', size: 'lg', icon: 'arrow-right' %}
      {% render 'button', label: section.settings.cta_secondary_label, url: section.settings.cta_secondary_url, style: 'outline', size: 'lg' %}
    </div>
  </div>

  {%- if section.settings.show_cue -%}
    <div class="hero__cue" aria-hidden="true">
      {%- render 'icon', name: 'chevron-down', size: 26 -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero (Vollbild)",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Overline",
      "default": "Auto-Aufbereitung in Innsbruck"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift (H1)",
      "default": "Dein Auto. Perfekt gepflegt."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Untertext",
      "default": "Professionelles Detailing für Lack, Interieur und Felgen – mobil bei dir vor Ort oder in unserer Werkstatt in Innsbruck. Präzision bis ins letzte Detail."
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "cta_primary_label",
      "label": "Primärer Button: Text",
      "default": "Jetzt Termin buchen"
    },
    {
      "type": "url",
      "id": "cta_primary_url",
      "label": "Primärer Button: Ziel"
    },
    {
      "type": "text",
      "id": "cta_secondary_label",
      "label": "Sekundärer Button: Text",
      "default": "Leistungen entdecken"
    },
    {
      "type": "url",
      "id": "cta_secondary_url",
      "label": "Sekundärer Button: Ziel"
    },
    {
      "type": "header",
      "content": "Bild & Darstellung"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hintergrundbild",
      "info": "Empfohlen: dunkles, hochglänzendes Fahrzeugfoto, min. 2000 px breit."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Alt-Text des Bildes",
      "default": "Hochglanzpoliertes Auto in dunkler Studiobeleuchtung"
    },
    {
      "type": "range",
      "id": "overlay",
      "label": "Abdunkelung",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 65
    },
    {
      "type": "select",
      "id": "height",
      "label": "Höhe",
      "options": [
        { "value": "full", "label": "Vollbild" },
        { "value": "large", "label": "Groß" },
        { "value": "medium", "label": "Mittel" }
      ],
      "default": "full"
    },
    {
      "type": "checkbox",
      "id": "show_cue",
      "label": "Scroll-Hinweis anzeigen",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Hero (Vollbild)",
      "category": "KlaroClean"
    }
  ]
}
{% endschema %}
