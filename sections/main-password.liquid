{%- comment -%}
  sections/main-password.liquid — „Bald online“-Seite (Passwortschutz).
{%- endcomment -%}

<section class="section">
  <div class="page-width status-page">
    <span class="site-header__wordmark" style="font-size: 1.8rem;">Klaro<span class="accent">Clean</span></span>
    <h1>{{ section.settings.heading }}</h1>
    <p class="lead">{{ section.settings.text }}</p>

    {%- form 'storefront_password' -%}
      {%- if form.errors -%}
        <div class="form-error" role="alert">{{ 'password.error' | t }}</div>
      {%- endif -%}
      <div style="display: flex; gap: var(--space-sm); max-width: 420px; width: 100%;">
        <label class="visually-hidden" for="Password">{{ 'password.label' | t }}</label>
        <input class="field__input" type="password" id="Password" name="password"
          placeholder="{{ 'password.label' | t }}" autocomplete="current-password">
        <button class="btn btn--primary" type="submit">{{ 'password.submit' | t }}</button>
      </div>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Passwort-Seite",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Bald glänzt es hier."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Unsere neue Website ist in Arbeit. Termine kannst du trotzdem schon vereinbaren – ruf uns einfach an."
    }
  ]
}
{% endschema %}
